---
/**
 * Testimonials Section — identical to demo8 glassmorphism design
 *
 * Static Astro SSG component. Zero client JS.
 * Overline + display heading + subtitle header.
 * Cards: 5 gold stars, italic quote, horizontal author row.
 */

import { useTranslations } from '@/i18n';
import { getTestimonials } from '@lib/content';
import type { Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const testimonials = await getTestimonials(lang);
---

<section
  id="testimonials"
  class="testimonials-section"
  aria-label={t('testimonials.ariaLabel')}
>
  <div class="testimonials-container">

    <!-- Section header: overline + display heading + subtitle -->
    <div class="section-header">
      <span class="overline">{t('testimonials.overline')}</span>
      <h2 class="testimonials-heading">{t('testimonials.heading')}</h2>
      <p class="testimonials-subtitle">{t('testimonials.subtitle')}</p>
    </div>

    <div class="testimonials-grid">
      {testimonials.map((testimonial) => (
        <article class="testimonial-card">

          <!-- 5 gold stars -->
          <div class="testimonial-stars" aria-label="5 stars">
            {[1,2,3,4,5].map(() => (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            ))}
          </div>

          <!-- Quote with truncation + Read more (CSS-only, AC#2) -->
          <blockquote>
            <p class="testimonial-text">"{testimonial.data.quote}"</p>
            <span class="testimonial-read-more" aria-hidden="true">{t('testimonials.readMore')}</span>

            <!-- Author attribution inside blockquote (AC#4) -->
            <footer class="testimonial-author">
              <div class="testimonial-avatar">
                {testimonial.data.image ? (
                  <img
                    src={testimonial.data.image}
                    alt={testimonial.data.imageAlt ?? testimonial.data.name}
                    width="48"
                    height="48"
                    loading="lazy"
                  />
                ) : (
                  <span class="testimonial-initials" aria-hidden="true">
                    {testimonial.data.name.split(' ').map((n: string) => n[0]).join('').toUpperCase().slice(0, 2)}
                  </span>
                )}
              </div>
              <div class="testimonial-info">
                <cite class="testimonial-name">{testimonial.data.name}</cite>
                {testimonial.data.type && (
                  <span class="testimonial-role">{testimonial.data.type}</span>
                )}
              </div>
            </footer>
          </blockquote>

        </article>
      ))}
    </div>

  </div>
</section>

<style>
  /* ─── Section ─────────────────────────────────────────────── */
  .testimonials-section {
    position: relative;
    padding: 10rem 0;
    background:
      radial-gradient(ellipse 60% 80% at 80% 50%, rgba(183, 110, 121, 0.25) 0%, transparent 65%),
      radial-gradient(ellipse 40% 60% at 15% 50%, rgba(212, 165, 165, 0.1) 0%, transparent 55%),
      var(--color-cream, #F5EDE8);
  }

  /* ─── Container ──────────────────────────────────────────── */
  .testimonials-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ─── Section Header ─────────────────────────────────────── */
  .section-header {
    text-align: center;
    margin-bottom: 6rem;
  }

  .overline {
    display: block;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-primary, #B76E79);
    margin-bottom: 1rem;
  }

  .testimonials-heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0.02em;
    color: var(--color-charcoal, #2A2A2A);
    margin-bottom: 1rem;
  }

  .testimonials-subtitle {
    font-family: var(--font-body);
    font-size: 1.1rem;
    line-height: 1.6;
    color: #4A4A4A;
    max-width: 600px;
    margin: 0 auto;
  }

  /* ─── Grid ───────────────────────────────────────────────── */
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  /* ─── Card — exact demo8 glass-strong styling ────────────── */
  .testimonial-card {
    padding: 4rem;
    border-radius: 20px;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-top: 2px solid rgba(255, 255, 255, 0.6);
    border-left: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 8px 32px rgba(183, 110, 121, 0.1), inset 0 2px 4px rgba(255, 255, 255, 0.5);
  }

  .testimonial-card:hover {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.28);
    box-shadow:
      0 16px 48px rgba(183, 110, 121, 0.15),
      0 0 30px rgba(212, 165, 165, 0.2),
      inset 0 2px 4px rgba(255, 255, 255, 0.6);
    border-color: rgba(212, 165, 165, 0.45);
  }

  /* ─── Stars ──────────────────────────────────────────────── */
  .testimonial-stars {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 1rem;
    color: var(--color-secondary, #C9A87C);
  }

  .testimonial-stars svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  /* ─── Quote text — truncated at 4 lines (AC#2) ──────────── */
  .testimonial-text {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-charcoal, #2A2A2A);
    margin-bottom: 0.5rem;
    font-style: italic;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ─── Read more hint (CSS-only, AC#2) ───────────────────── */
  .testimonial-read-more {
    display: block;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-primary, #B76E79);
    margin-bottom: 1.5rem;
    cursor: default;
  }

  /* ─── Author row (blockquote footer, AC#4) ──────────────── */
  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0;
  }

  /* ─── Avatar circle ──────────────────────────────────────── */
  .testimonial-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: linear-gradient(135deg, #D4A5A5, #C9A87C);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .testimonial-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .testimonial-initials {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: #ffffff;
  }

  /* ─── Name & role ────────────────────────────────────────── */
  .testimonial-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .testimonial-name {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-charcoal, #1A1A1A);
  }

  .testimonial-role {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: #4A4A4A;
  }

  /* ─── Tablet (768px–1023px): 2 columns (AC#3) ───────────── */
  @media (max-width: 1023px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ─── Mobile (<768px): 1 column (AC#2, AC#3) ────────────── */
  @media (max-width: 767px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }

    .testimonials-section {
      padding: 6rem 0;
    }

    .section-header {
      margin-bottom: 4rem;
    }
  }

  /* ─── Reduced motion ─────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .testimonial-card {
      transition: none;
    }

    .testimonial-card:hover {
      transform: none;
    }
  }
</style>
