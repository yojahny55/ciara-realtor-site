---
/**
 * Trust Bar Component
 *
 * Horizontal row of credibility signals placed after Intent Cards on homepage.
 * Reusable common component — also used above forms in Story 5.7.
 * Pure SSG, no client JS, no hydration directive.
 */

import { useTranslations } from '@/i18n';
import type { Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const trustItems = [
  { key: 'licensed' as const, icon: 'shield' },
  { key: 'responseTime' as const, icon: 'clock' },
  { key: 'privacy' as const, icon: 'lock' },
  { key: 'bilingual' as const, icon: 'globe' },
];
---

<section class="trust-bar" aria-label={t('trust.ariaLabel')}>
  <ul class="trust-list" role="list">
    {trustItems.map((item) => (
      <li class="trust-item">
        <span class="trust-icon" aria-hidden="true">
          {item.icon === 'shield' && (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
          )}
          {item.icon === 'clock' && (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          )}
          {item.icon === 'lock' && (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          )}
          {item.icon === 'globe' && (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          )}
        </span>
        <span class="trust-text">{t(`trust.${item.key}` as const)}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  /* ─── Section ─────────────────────────────────────────────── */
  .trust-bar {
    background: var(--color-cream-white, #FFFAF8);
    padding: var(--space-4, 16px) var(--space-md, 32px);
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  /* ─── List ────────────────────────────────────────────────── */
  .trust-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-6, 24px);
    max-width: 1200px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  /* ─── Item ────────────────────────────────────────────────── */
  .trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-2, 8px);
  }

  /* ─── Icon ────────────────────────────────────────────────── */
  .trust-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-secondary, #C9A87C);
    flex-shrink: 0;
  }

  /* ─── Text ────────────────────────────────────────────────── */
  .trust-text {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-charcoal, #2A2A2A);
    line-height: 1.4;
  }

  /* ─── Desktop (≥ 768px): single row ─────────────────────── */
  @media (min-width: 768px) {
    .trust-list {
      flex-wrap: nowrap;
    }
  }
</style>
