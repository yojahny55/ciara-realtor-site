---
/**
 * Spanish Homepage
 *
 * Main landing page for Spanish-speaking visitors.
 * Route: /es/
 */

import Page from "@/layouts/Page.astro";
import { useTranslations } from "@/i18n";
import HeroSection from "@/components/homepage/hero-section.astro";
import IntentCards from "@/components/homepage/intent-cards.astro";
import TrustBar from "@/components/common/trust-bar.astro";
import TestimonialsSection from "@/components/homepage/testimonials-section.astro";
import InstagramFeed from "@/components/homepage/instagram-feed.astro";
import HomepageSchema from "@/components/common/homepage-schema.astro";

const lang = "es";
const t = useTranslations(lang);
---

<Page
  title="Ciara Ruiz - Agente de Bienes Raíces en Tampa Bay"
  description="Agente de bienes raíces bilingüe de confianza en Tampa Bay, FL. Especializada en ayudar a familias a comprar, vender e invertir en propiedades. Asesoría experta en inglés y español."
  image="/og-default.jpg"
  type="website"
  maxWidth="full"
  noPadding={true}
>
  <HomepageSchema lang={lang} />
  <HeroSection lang={lang} />
  <div class="section-bg section-bg-glass">
    <IntentCards lang={lang} />
  </div>
  <div class="section-bg section-bg-clear">
    <TrustBar lang={lang} />
  </div>
  <div class="section-bg section-bg-glass">
    <TestimonialsSection lang={lang} />
  </div>
  <div class="section-bg section-bg-clear">
    <InstagramFeed lang={lang} />
  </div>
</Page>
